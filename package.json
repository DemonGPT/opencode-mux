{
  "name": "opencode-mux",
  "version": "1.2.0",
  "description": "Drop-in opencode wrapper that opens tmux panes for subagent sessions automatically",
  "type": "module",
  "bin": {
    "opencode-mux": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/e2e-smoke.ts",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@opencode/client": "^2.1.3",
    "@opencode/client-legacy": "npm:@opencode/client@2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@opencode/client-legacy": {
      "effect": "4.0.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DemonGPT/opencode-mux"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "tmux",
    "subagent",
    "multiplexer",
    "wrapper",
    "tui"
  ]
}
